enter(/io.mbd) {
    const path "io.mbdb";
};

enter(/math.mbd) {
    const path "math.mbdb";
};

nochk {
    print_i64,
    print_string
}::strict;

function main() -> int {
    print_string("Mobdrive standard library");
    print_i64(max_i64(abs_i64(-12), 7));
    print_i64(string_length("hello"));
    return 0;
}
